{
  "name": "icoweb",
  "description": "Frontend for ICOdaq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test-watch": "vitest",
    "tailwind": "@tailwindcss/cli -i ./src/styles/tailwind/tailwind.css -o ./src/styles/tailwind/tailwind-output.css --watch",
    "generate-client": "openapi-ts --input http://localhost:33215/openapi.json --output ./src/client --client fetch",
    "start": "concurrently \"npm run dev \" \"npm run tailwind \""
  },
  "repository": {
    "type": "git",
    "url": "https://git.ift.tuwien.ac.at/lab/ift/icotronic/icoweb"
  },
  "author": {
    "name": "Moritz Breurather",
    "email": "breurather@ift.at"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "@vueuse/core": "^15.0.0",
    "chart.js": "^4.4.3",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-crosshair": "^2.0.0",
    "chartjs-plugin-zoom": "^2.0.1",
    "clipboard": "^2.0.11",
    "date-fns": "^4.4.0",
    "mime": "^4.1.1",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "rollup": "^4.44.0",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.4.31",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@pinia/testing": "^2.0.2",
    "@tailwindcss/cli": "^4.3.5",
    "@types/chartjs-plugin-crosshair": "^1.1.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/ui": "^5.0.5",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "js-yaml": "$js-yaml"
  }
}
