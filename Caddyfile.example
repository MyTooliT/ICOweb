# Example: ICOweb over https that can reach many plain-http ICOapi instances.
#
# Build ICOweb with VITE_API_PROXY_PREFIX=/proxy (see README). When a user
# enters an http API (e.g. 192.168.1.20:33215) on an https page, ICOweb calls
#   https://icoweb.lab/proxy/192.168.1.20:33215/api/v1/...
# and this server forwards it to http://192.168.1.20:33215/api/v1/...
# WebSockets (wss://icoweb.lab/proxy/...) are forwarded too.

icoweb.lab {
	# Caddy's local CA. Trust it on the clients (`caddy trust`) or use a real cert.
	tls internal

	# SECURITY: only forward to the targets matched here, otherwise everyone who
	# can reach this server can use it to reach anything the server can.
	# This allows private IPv4 ranges and *.lab names, on ports 33000-33999.
	@icoapi path_regexp icoapi ^/proxy/((?:192\.168|10\.\d+|172\.(?:1[6-9]|2\d|3[01]))\.\d+\.\d+|[a-z0-9-]+\.lab):(33[0-9][0-9][0-9])/

	handle @icoapi {
		# Remove "/proxy/<host>:<port>" from the path
		uri path_regexp ^/proxy/[^/]+/ /
		reverse_proxy {re.icoapi.1}:{re.icoapi.2}
	}

	# Anything else under the prefix is refused
	handle /proxy/* {
		respond "Target not allowed" 403
	}

	# ICOweb itself (here: the static files, or e.g. `reverse_proxy icoweb:80`)
	handle {
		root * /srv/icoweb
		try_files {path} /index.html
		file_server
	}
}
