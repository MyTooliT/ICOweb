# Caddy for the compose setup (docker-compose.yml), configured via environment:
#   ICOWEB_HOST            site address of the server (default: localhost). Caddy
#                          picks the protocol from it:
#                            http://128.130.104.56   plain http, no certificate
#                            128.130.104.56          https with Caddy's own CA
#                            icoweb.example.org      https, Let's Encrypt (public DNS)
#   ICOAPI_ALLOWED_HOSTS   regular expression (no capturing groups) of the hosts
#                          of ICOapi instances that may be reached via /proxy

{$ICOWEB_HOST:localhost} {
	# Only these targets may be reached, on ports 33000-33999
	@icoapi path_regexp icoapi ^/proxy/({$ICOAPI_ALLOWED_HOSTS}):(33[0-9][0-9][0-9])/

	handle @icoapi {
		# Remove "/proxy/<host>:<port>" from the path
		uri path_regexp ^/proxy/[^/]+/ /
		reverse_proxy {re.icoapi.1}:{re.icoapi.2}
	}

	handle /proxy/* {
		respond "Target not allowed" 403
	}

	# ICOweb (nginx container)
	handle {
		reverse_proxy icoweb:80
	}
}
